{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "tr-TR",
    "sourceQueryCulture": "tr-TR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "_Olculer",
        "lineageTag": "54a856ca-c8de-4985-9a64-275dbd88d912",
        "columns": [
          {
            "name": "Gizli",
            "dataType": "string",
            "sourceColumn": "Gizli",
            "lineageTag": "ceabf65e-e321-492e-bb46-4d243d207f68",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Olculer",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Kaynak = #table(type table [Gizli = text], {})",
                "in",
                "    Kaynak"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Toplam TEU",
            "expression": "SUM ( Challenge[TEU] )",
            "lineageTag": "0af0820f-3808-45b0-9d94-db69bef36838",
            "formatString": "#,0",
            "description": "Seçili kişi/bölge/dönem için toplam TEU."
          },
          {
            "name": "Aktif E-posta",
            "expression": [
              "VAR upn = LOWER ( USERPRINCIPALNAME () )",
              "VAR kayitli =",
              "    CALCULATE ( COUNTROWS ( Kisiler ), REMOVEFILTERS ( Kisiler ), Kisiler[Email] = upn )",
              "RETURN",
              "    -- Raporu açan kişi listede yoksa (ör. Desktop'ta deneme) demo kullanıcısı gösterilir.",
              "    IF ( kayitli > 0, upn, \"can.demir@ornek.com\" )"
            ],
            "lineageTag": "93682835-ad15-4982-978a-c0225b9f80bc",
            "description": "Raporu açan kullanıcının e-postası."
          },
          {
            "name": "Ben mi",
            "expression": [
              "VAR em = [Aktif E-posta]",
              "RETURN IF ( SELECTEDVALUE ( Kisiler[Email] ) = em, 1, 0 )"
            ],
            "lineageTag": "af682c9b-efbd-4ea5-be07-b307b79542a7",
            "formatString": "0",
            "description": "Satırdaki kişi raporu açan kişiyse 1."
          },
          {
            "name": "Son Veri Günü",
            "expression": "CALCULATE ( MAX ( Challenge[Tarih] ), REMOVEFILTERS ( Challenge ) )",
            "lineageTag": "0ff25a1f-6dcf-4ed0-b0a1-48aa7d149c1d",
            "formatString": "dd.MM.yyyy",
            "description": "Demo için 'bugün' = verideki son gün. Canlı veride TODAY () kullanın."
          },
          {
            "name": "Son Güncelleme",
            "expression": [
              "\"Son güncelleme: \"",
              "    & FORMAT ( CALCULATE ( MAX ( Challenge[YuklemeZamani] ), REMOVEFILTERS ( Challenge ) ), \"dd.MM.yyyy HH:mm\" )"
            ],
            "lineageTag": "dfb239de-579d-4c85-a6b1-2df2a0175600"
          },
          {
            "name": "Sıra",
            "expression": [
              "IF (",
              "    ISINSCOPE ( Kisiler[Kisi] ),",
              "    RANKX ( ALLSELECTED ( Kisiler[Kisi] ), [Toplam TEU], , DESC, SKIP )",
              ")"
            ],
            "lineageTag": "f00c9c42-8aa8-4300-b3ac-989b5cf2c083",
            "formatString": "0"
          },
          {
            "name": "Liderlik TEU",
            "expression": [
              "VAR s = [Sıra]",
              "RETURN IF ( s <= 15 || [Ben mi] = 1, [Toplam TEU] )"
            ],
            "lineageTag": "8658a07d-a24c-476b-8e09-d8434106acfb",
            "formatString": "#,0",
            "description": "İlk 15 kişi + raporu açan kişi."
          },
          {
            "name": "Bar Rengi",
            "expression": "SWITCH ( TRUE (), [Ben mi] = 1, \"#EB6834\", [Sıra] = 1, \"#2A78D6\", \"#C8C6C4\" )",
            "lineageTag": "898c7d3d-670c-4456-8c2f-f992582ad424"
          },
          {
            "name": "Satır Rengi",
            "expression": "IF ( [Ben mi] = 1, \"#FDF0EA\", \"#FFFFFF\" )",
            "lineageTag": "a2efeff5-14b5-4a0c-835c-5193dc2e5a55"
          },
          {
            "name": "Benim TEU",
            "expression": [
              "VAR em = [Aktif E-posta]",
              "RETURN",
              "    COALESCE ( CALCULATE ( [Toplam TEU], REMOVEFILTERS ( Kisiler ), Kisiler[Email] = em ), 0 )"
            ],
            "lineageTag": "c985e170-c209-4d98-a30e-2b19a5ce0290",
            "formatString": "#,0"
          },
          {
            "name": "Benim Hedef",
            "expression": [
              "VAR em = [Aktif E-posta]",
              "RETURN CALCULATE ( MAX ( Kisiler[HedefTEU] ), REMOVEFILTERS ( Kisiler ), Kisiler[Email] = em )"
            ],
            "lineageTag": "eeeffd00-7739-4758-aef2-4fb40552a7fb",
            "formatString": "#,0"
          },
          {
            "name": "Hedef Oranı",
            "expression": "DIVIDE ( [Benim TEU], [Benim Hedef] )",
            "lineageTag": "9930a903-a496-4c27-8d64-3f23aea3ba35",
            "formatString": "0%"
          },
          {
            "name": "Hedef Açıklama",
            "expression": [
              "VAR kalan = [Benim Hedef] - [Benim TEU]",
              "RETURN",
              "    \"Hedef \" & FORMAT ( [Benim Hedef], \"#,0\" ) & \" TEU · %\" & FORMAT ( [Hedef Oranı] * 100, \"0\" )",
              "        & IF ( kalan > 0, \" · \" & FORMAT ( kalan, \"#,0\" ) & \" TEU kaldı\", \" · Hedef tamamlandı\" )"
            ],
            "lineageTag": "de1b7563-254d-4c2e-b8f0-00420a1dc81d"
          },
          {
            "name": "Katılımcı Sayısı",
            "expression": "COUNTROWS ( ALLSELECTED ( Kisiler[Kisi] ) )",
            "lineageTag": "1ecb4476-6747-4b53-b91b-d751a8d633f3",
            "formatString": "0"
          },
          {
            "name": "Benim Sıram",
            "expression": [
              "VAR benim = [Benim TEU]",
              "RETURN COUNTROWS ( FILTER ( ALLSELECTED ( Kisiler[Kisi] ), [Toplam TEU] > benim ) ) + 1"
            ],
            "lineageTag": "dcb37082-a53c-40c4-aa56-9848b6b95266",
            "formatString": "0"
          },
          {
            "name": "Dünkü Sıram",
            "expression": [
              "VAR d = [Son Veri Günü] - 1",
              "VAR em = [Aktif E-posta]",
              "VAR benimDun =",
              "    CALCULATE ( [Toplam TEU], REMOVEFILTERS ( Kisiler ), Kisiler[Email] = em, Tarih[Tarih] <= d )",
              "RETURN",
              "    COUNTROWS (",
              "        FILTER ( ALLSELECTED ( Kisiler[Kisi] ), CALCULATE ( [Toplam TEU], Tarih[Tarih] <= d ) > benimDun )",
              "    ) + 1"
            ],
            "lineageTag": "43a38f89-1f26-4a64-b51a-d83a5b1e6077",
            "formatString": "0"
          },
          {
            "name": "Sıram Metin",
            "expression": "FORMAT ( [Benim Sıram], \"0\" ) & \".\"",
            "lineageTag": "39be2d16-6c34-41af-be32-21601e2a9ffe"
          },
          {
            "name": "Sıra Açıklama",
            "expression": [
              "VAR bugun = [Benim Sıram]",
              "VAR dun = [Dünkü Sıram]",
              "VAR fark = dun - bugun",
              "VAR degisim =",
              "    SWITCH (",
              "        TRUE (),",
              "        fark > 0, UNICHAR ( 9650 ) & \" \" & fark & \" sıra yükseldin (\" & dun & \". → \" & bugun & \".)\",",
              "        fark < 0, UNICHAR ( 9660 ) & \" \" & ABS ( fark ) & \" sıra düştün (\" & dun & \". → \" & bugun & \".)\",",
              "        \"Dünle aynı sıradasın\"",
              "    )",
              "RETURN [Katılımcı Sayısı] & \" kişi içinde · \" & degisim"
            ],
            "lineageTag": "fc78169e-473c-4470-b525-8928a5356016"
          },
          {
            "name": "Üsttekiyle Fark",
            "expression": [
              "VAR benim = [Benim TEU]",
              "VAR ust = MINX ( FILTER ( ALLSELECTED ( Kisiler[Kisi] ), [Toplam TEU] > benim ), [Toplam TEU] )",
              "RETURN IF ( ISBLANK ( ust ), 0, ust - benim )"
            ],
            "lineageTag": "af5a1200-f480-49a2-b5cd-12d236a00e11",
            "formatString": "#,0\" TEU\""
          },
          {
            "name": "Üstteki Açıklama",
            "expression": [
              "VAR benim = [Benim TEU]",
              "VAR t =",
              "    FILTER ( ADDCOLUMNS ( ALLSELECTED ( Kisiler[Kisi] ), \"@teu\", [Toplam TEU] ), [@teu] > benim )",
              "VAR ustTeu = MINX ( t, [@teu] )",
              "VAR ad = CONCATENATEX ( TOPN ( 1, FILTER ( t, [@teu] = ustTeu ), Kisiler[Kisi], ASC ), Kisiler[Kisi] )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( ustTeu ),",
              "        \"Zirvedesin, farkı koru!\",",
              "        \"Önündeki: \" & ad & \" · \" & FORMAT ( ustTeu, \"#,0\" ) & \" TEU\"",
              "    )"
            ],
            "lineageTag": "bd70fefc-09d4-41f0-9f0a-c651024ae9f7"
          },
          {
            "name": "Bugün Benim TEU",
            "expression": [
              "VAR d = [Son Veri Günü]",
              "VAR em = [Aktif E-posta]",
              "RETURN",
              "    COALESCE (",
              "        CALCULATE ( [Toplam TEU], REMOVEFILTERS ( Kisiler ), Kisiler[Email] = em, Tarih[Tarih] = d ),",
              "        0",
              "    )"
            ],
            "lineageTag": "59e2ec52-7980-47de-870b-a17ff8870e8e",
            "formatString": "+#,0\" TEU\";-#,0\" TEU\";0\" TEU\""
          },
          {
            "name": "Bugün Açıklama",
            "expression": [
              "VAR d = [Son Veri Günü]",
              "VAR teu = CALCULATE ( [Toplam TEU], REMOVEFILTERS ( Kisiler ), Tarih[Tarih] = d )",
              "VAR giris = CALCULATE ( COUNTROWS ( Challenge ), REMOVEFILTERS ( Kisiler ), Tarih[Tarih] = d )",
              "RETURN \"Şirket geneli: +\" & FORMAT ( teu, \"#,0\" ) & \" TEU · \" & giris & \" giriş\""
            ],
            "lineageTag": "cd772958-e6f5-45a8-a4cd-68d02c341d58"
          },
          {
            "name": "Lider Başlık",
            "expression": [
              "VAR t = ADDCOLUMNS ( ALLSELECTED ( Kisiler[Kisi] ), \"@teu\", [Toplam TEU] )",
              "VAR enYuksek = MAXX ( t, [@teu] )",
              "VAR lider = CONCATENATEX ( TOPN ( 1, FILTER ( t, [@teu] = enYuksek ), Kisiler[Kisi], ASC ), Kisiler[Kisi] )",
              "RETURN",
              "    \"Lider \" & lider & \" (\" & FORMAT ( enYuksek, \"#,0\" ) & \" TEU) · Sen \" & [Benim Sıram] & \". sıradasın\""
            ],
            "lineageTag": "d0859776-21dc-40c1-a484-d2b3f20baabc"
          },
          {
            "name": "Yarış TEU",
            "expression": [
              "VAR seri = SELECTEDVALUE ( Seri[SeriNo] )",
              "VAR gun = MAX ( Tarih[Tarih] )",
              "VAR em = [Aktif E-posta]",
              "VAR t =",
              "    ADDCOLUMNS ( ALLSELECTED ( Kisiler[Kisi] ), \"@teu\", CALCULATE ( [Toplam TEU], ALLSELECTED ( Tarih ) ) )",
              "VAR benimAd =",
              "    CALCULATE ( SELECTEDVALUE ( Kisiler[Kisi] ), REMOVEFILTERS ( Kisiler ), Kisiler[Email] = em )",
              "VAR benimTeu = MAXX ( FILTER ( t, Kisiler[Kisi] = benimAd ), [@teu] )",
              "VAR benimSira = COUNTROWS ( FILTER ( t, [@teu] > benimTeu ) ) + 1",
              "VAR hedefSira = SWITCH ( seri, 1, benimSira, 2, 1, 3, benimSira - 1, 4, benimSira + 1 )",
              "VAR kisi =",
              "    IF (",
              "        seri = 1,",
              "        benimAd,",
              "        CONCATENATEX (",
              "            TOPN ( 1, FILTER ( t, RANKX ( t, [@teu], , DESC, SKIP ) = hedefSira ), Kisiler[Kisi], ASC ),",
              "            Kisiler[Kisi]",
              "        )",
              "    )",
              "RETURN",
              "    IF (",
              "        gun > [Son Veri Günü] || kisi = \"\" || hedefSira < 1,",
              "        BLANK (),",
              "        CALCULATE ( [Toplam TEU], REMOVEFILTERS ( Kisiler ), Kisiler[Kisi] = kisi, Tarih[Tarih] <= gun )",
              "    )"
            ],
            "lineageTag": "4d32a879-9a26-48c3-b380-0e4532ec90ed",
            "formatString": "#,0",
            "description": "Sen / Lider / bir öndeki / bir arkadaki kişinin kümülatif TEU'su."
          },
          {
            "name": "Son Giriş TEU",
            "expression": "IF ( MAX ( Challenge[SonGirisSirasi] ) <= 6, SUM ( Challenge[TEU] ) )",
            "lineageTag": "6e48cbe3-c03d-48ef-8ec8-b0762deaa92e",
            "formatString": "#,0",
            "description": "Son 6 giriş."
          },
          {
            "name": "Lider Bölge Başlık",
            "expression": [
              "VAR t = ADDCOLUMNS ( ALLSELECTED ( Kisiler[Bolge] ), \"@teu\", [Toplam TEU] )",
              "VAR enYuksek = MAXX ( t, [@teu] )",
              "RETURN",
              "    CONCATENATEX ( TOPN ( 1, FILTER ( t, [@teu] = enYuksek ), Kisiler[Bolge], ASC ), Kisiler[Bolge] )",
              "        & \" bölgesi önde\""
            ],
            "lineageTag": "6fa525da-d236-4716-ac30-a62149411005"
          },
          {
            "name": "Kişi Sayısı",
            "expression": "COUNTROWS ( Kisiler )",
            "lineageTag": "16e45ff8-3370-4815-aeb9-9c198e630bba",
            "formatString": "0"
          },
          {
            "name": "Kişi Başı TEU",
            "expression": "DIVIDE ( [Toplam TEU], [Kişi Sayısı] )",
            "lineageTag": "5e3617eb-d96e-437e-a03b-4d1f6583bfbb",
            "formatString": "#,0.0"
          },
          {
            "name": "Bölge Hedef %",
            "expression": "DIVIDE ( [Toplam TEU], SUM ( Kisiler[HedefTEU] ) )",
            "lineageTag": "8b29c433-9ba1-4a3f-b712-f0b5dfc81c69",
            "formatString": "0%"
          },
          {
            "name": "Hedefe Ulaşan",
            "expression": "COALESCE ( COUNTROWS ( FILTER ( Kisiler, [Toplam TEU] >= Kisiler[HedefTEU] ) ), 0 )",
            "lineageTag": "c48b0bf5-92a6-4093-98c6-3eecbd0b6d4a",
            "formatString": "0"
          },
          {
            "name": "Aktif Katılımcı %",
            "expression": [
              "VAR d = [Son Veri Günü]",
              "VAR aktif =",
              "    COUNTROWS (",
              "        FILTER ( Kisiler, CALCULATE ( COUNTROWS ( Challenge ), Tarih[Tarih] > d - 7, Tarih[Tarih] <= d ) > 0 )",
              "    )",
              "RETURN DIVIDE ( aktif, [Kişi Sayısı] )"
            ],
            "lineageTag": "4304cdcf-7d5c-4429-b522-c511b469dd35",
            "formatString": "0%",
            "description": "Son 7 günde en az bir giriş yapanların oranı."
          },
          {
            "name": "Kümülatif TEU",
            "expression": [
              "VAR gun = MAX ( Tarih[Tarih] )",
              "RETURN IF ( gun > [Son Veri Günü], BLANK (), CALCULATE ( [Toplam TEU], Tarih[Tarih] <= gun ) )"
            ],
            "lineageTag": "b6d53690-fa7a-45e7-913c-6916c5b2e6c2",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Kisiler",
        "lineageTag": "e2b5f7ba-b87a-40d2-b60f-c4dddabe407f",
        "columns": [
          {
            "name": "KisiID",
            "dataType": "int64",
            "sourceColumn": "KisiID",
            "lineageTag": "31cd1f27-db14-49e1-96c0-155a8cc73ce6",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Kisi",
            "dataType": "string",
            "sourceColumn": "Kisi",
            "lineageTag": "1447cce5-2fc6-425c-849a-c7e9bd5bf033",
            "summarizeBy": "none"
          },
          {
            "name": "Email",
            "dataType": "string",
            "sourceColumn": "Email",
            "lineageTag": "b8c742b5-387a-4a05-ad01-e7e475c12c60",
            "summarizeBy": "none"
          },
          {
            "name": "Bolge",
            "dataType": "string",
            "sourceColumn": "Bolge",
            "lineageTag": "4f0bcb4a-ee39-448a-b9ba-2540c613e610",
            "summarizeBy": "none"
          },
          {
            "name": "Yonetici",
            "dataType": "string",
            "sourceColumn": "Yonetici",
            "lineageTag": "d7788341-776d-4cd9-a800-35459f4bb6b1",
            "summarizeBy": "none"
          },
          {
            "name": "HedefTEU",
            "dataType": "int64",
            "sourceColumn": "HedefTEU",
            "lineageTag": "462deff6-f20c-472b-8afc-8d7b7464fed5",
            "summarizeBy": "sum",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Kisiler",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Gerçek veride bu adımı kendi personel listenizle (Excel, SharePoint, SQL) değiştirin.",
                "    Kaynak = #table(",
                "        type table [KisiID = Int64.Type, Kisi = text, Email = text, Bolge = text, Yonetici = text, HedefTEU = Int64.Type],",
                "        {",
                "        {1, \"Ayşe Kaya\", \"ayse.kaya@ornek.com\", \"Marmara\", \"Leyla Güneş\", 250},",
                "        {2, \"Mehmet Tunç\", \"mehmet.tunc@ornek.com\", \"Ege\", \"Nil Ateş\", 250},",
                "        {3, \"Can Demir\", \"can.demir@ornek.com\", \"Marmara\", \"Leyla Güneş\", 250},",
                "        {4, \"Elif Şahin\", \"elif.sahin@ornek.com\", \"İç Anadolu\", \"Okan Bulut\", 250},",
                "        {5, \"Burak Yıldız\", \"burak.yildiz@ornek.com\", \"Akdeniz\", \"Serkan Uysal\", 250},",
                "        {6, \"Zeynep Arslan\", \"zeynep.arslan@ornek.com\", \"Marmara\", \"Leyla Güneş\", 250},",
                "        {7, \"Emre Koç\", \"emre.koc@ornek.com\", \"Ege\", \"Nil Ateş\", 250},",
                "        {8, \"Selin Aydın\", \"selin.aydin@ornek.com\", \"Karadeniz\", \"Murat Akın\", 250},",
                "        {9, \"Kerem Öztürk\", \"kerem.ozturk@ornek.com\", \"Marmara\", \"Leyla Güneş\", 250},",
                "        {10, \"Deniz Çelik\", \"deniz.celik@ornek.com\", \"Akdeniz\", \"Serkan Uysal\", 250},",
                "        {11, \"Ozan Kurt\", \"ozan.kurt@ornek.com\", \"İç Anadolu\", \"Okan Bulut\", 250},",
                "        {12, \"Merve Polat\", \"merve.polat@ornek.com\", \"Karadeniz\", \"Murat Akın\", 250},",
                "        {13, \"Hakan Erdem\", \"hakan.erdem@ornek.com\", \"Ege\", \"Nil Ateş\", 250},",
                "        {14, \"Gizem Acar\", \"gizem.acar@ornek.com\", \"Marmara\", \"Leyla Güneş\", 250},",
                "        {15, \"Tolga Şen\", \"tolga.sen@ornek.com\", \"Akdeniz\", \"Serkan Uysal\", 250},",
                "        {16, \"Ali Yılmaz\", \"ali.yilmaz@ornek.com\", \"Marmara\", \"Leyla Güneş\", 250},",
                "        {17, \"Fatma Doğan\", \"fatma.dogan@ornek.com\", \"Ege\", \"Nil Ateş\", 250},",
                "        {18, \"Mustafa Kılıç\", \"mustafa.kilic@ornek.com\", \"Akdeniz\", \"Serkan Uysal\", 250},",
                "        {19, \"Esra Aslan\", \"esra.aslan@ornek.com\", \"İç Anadolu\", \"Okan Bulut\", 250},",
                "        {20, \"Hüseyin Çetin\", \"huseyin.cetin@ornek.com\", \"Karadeniz\", \"Murat Akın\", 250},",
                "        {21, \"Büşra Kara\", \"busra.kara@ornek.com\", \"Marmara\", \"Leyla Güneş\", 250},",
                "        {22, \"İbrahim Özdemir\", \"ibrahim.ozdemir@ornek.com\", \"Ege\", \"Nil Ateş\", 250},",
                "        {23, \"Cansu Yavuz\", \"cansu.yavuz@ornek.com\", \"Akdeniz\", \"Serkan Uysal\", 250},",
                "        {24, \"Oğuz Aksoy\", \"oguz.aksoy@ornek.com\", \"İç Anadolu\", \"Okan Bulut\", 250},",
                "        {25, \"Ebru Turan\", \"ebru.turan@ornek.com\", \"Karadeniz\", \"Murat Akın\", 250},",
                "        {26, \"Serdar Işık\", \"serdar.isik@ornek.com\", \"Marmara\", \"Leyla Güneş\", 250},",
                "        {27, \"Pınar Ekinci\", \"pinar.ekinci@ornek.com\", \"Ege\", \"Nil Ateş\", 250},",
                "        {28, \"Kaan Tekin\", \"kaan.tekin@ornek.com\", \"Akdeniz\", \"Serkan Uysal\", 250},",
                "        {29, \"Derya Bozkurt\", \"derya.bozkurt@ornek.com\", \"İç Anadolu\", \"Okan Bulut\", 250},",
                "        {30, \"Volkan Uçar\", \"volkan.ucar@ornek.com\", \"Karadeniz\", \"Murat Akın\", 250},",
                "        {31, \"Sibel Duman\", \"sibel.duman@ornek.com\", \"Marmara\", \"Leyla Güneş\", 250},",
                "        {32, \"Arda Kaplan\", \"arda.kaplan@ornek.com\", \"Ege\", \"Nil Ateş\", 250},",
                "        {33, \"Melis Sarı\", \"melis.sari@ornek.com\", \"Akdeniz\", \"Serkan Uysal\", 250},",
                "        {34, \"Barış Karaca\", \"baris.karaca@ornek.com\", \"İç Anadolu\", \"Okan Bulut\", 250},",
